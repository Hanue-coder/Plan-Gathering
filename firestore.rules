rules_version = '2';

// 권한 요약
// - 모임장(owner): 모임 정보·양식·항목·멤버 권한을 모두 관리
// - 쓰기 멤버(writer): 본인에게 할당된 공용 항목의 수량·준비 완료·메모 수정,
//                      담당 미정인 공용 항목 가져가기(내가 가져갈게)와 놓기
// - 읽기 멤버(reader): 읽기 + 개인 준비물의 본인 칸 체크
// - 개인 준비물의 체크는 누구든(모임장 포함) 본인 칸만 바꿀 수 있음
// - 모임 멤버가 아니면 그 모임의 어떤 내용도 읽을 수 없음
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function groupPath(gid) {
      return /databases/$(database)/documents/groups/$(gid);
    }
    function myMemberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }
    function isMember(gid) {
      return signedIn() && exists(myMemberPath(gid));
    }
    function myRole(gid) {
      return get(myMemberPath(gid)).data.role;
    }
    function isOwner(gid) {
      return isMember(gid) && myRole(gid) == 'owner';
    }
    function shortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // 내 모임 목록: members 컬렉션 그룹을 uid로 조회할 때 내 문서만 읽을 수 있음
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /groups/{gid} {
      function validGroup(d) {
        return d.keys().hasOnly(['name', 'date', 'startDate', 'nights', 'place', 'ownerUid', 'columns', 'createdAt'])
          && shortString(d.name, 1, 60)
          && shortString(d.date, 0, 60)
          && (!('startDate' in d) || d.startDate == '' || d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && (!('nights' in d) || (d.nights is int && d.nights >= 0 && d.nights <= 30))
          && shortString(d.place, 0, 60)
          && d.ownerUid is string
          && d.columns is list && d.columns.size() <= 20;
      }

      allow read: if isMember(gid);
      // 모임 생성: 만든 사람이 모임장 멤버 문서를 같은 배치에서 함께 만들어야 함
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validGroup(request.resource.data)
        && getAfter(myMemberPath(gid)).data.role == 'owner';
      allow update: if isOwner(gid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validGroup(request.resource.data);
      allow delete: if isOwner(gid);

      match /members/{uid} {
        function validMember(d) {
          return d.keys().hasOnly(['uid', 'role', 'name', 'photoURL', 'joinedAt', 'inviteCode'])
            && d.uid == uid
            && d.role in ['owner', 'writer', 'reader']
            && shortString(d.name, 1, 60);
        }
        function validInvite(code) {
          let inv = get(/databases/$(database)/documents/invites/$(code));
          return inv != null && inv.data.groupId == gid && inv.data.expiresAt > request.time;
        }

        allow read: if isMember(gid);
        allow create: if signedIn() && uid == request.auth.uid
          && validMember(request.resource.data)
          && (
            // 모임을 새로 만드는 사람
            (request.resource.data.role == 'owner'
              && !exists(groupPath(gid))
              && getAfter(groupPath(gid)).data.ownerUid == uid)
            ||
            // 초대 링크로 합류하는 사람은 읽기 멤버로만
            (request.resource.data.role == 'reader'
              && request.resource.data.inviteCode is string
              && validInvite(request.resource.data.inviteCode))
          );
        // 모임장만 다른 멤버의 권한(쓰기/읽기)을 바꿀 수 있음
        allow update: if isOwner(gid)
          && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['writer', 'reader'];
        allow delete: if signedIn() && (
          // 모임장이 멤버를 내보내기
          (isOwner(gid) && resource.data.role != 'owner')
          // 본인이 모임 나가기 (모임장 제외)
          || (uid == request.auth.uid && resource.data.role != 'owner')
          // 모임 삭제와 함께 모임장 문서 삭제
          || (isOwner(gid) && !existsAfter(groupPath(gid)))
        );
      }

      // 준비물 항목은 두 종류예요.
      // - 공용(kind 없음 또는 'shared'): 담당자 한 명이 챙김
      // - 개인('personal'): 멤버 모두가 각자 챙기고, checks 맵에 {사용자: true/false}로 기록
      match /items/{itemId} {
        function isPersonal(d) {
          return 'kind' in d && d.kind == 'personal';
        }
        function validShared(d) {
          return d.keys().hasOnly(['name', 'kind', 'assigneeUid', 'qty', 'done', 'memo', 'order', 'updatedAt'])
            && (!('kind' in d) || d.kind == 'shared')
            && shortString(d.name, 1, 80)
            && (d.assigneeUid == null || d.assigneeUid is string)
            && d.qty is int && d.qty >= 0 && d.qty <= 9999
            && d.done is bool
            && shortString(d.memo, 0, 200)
            && d.order is number;
        }
        function validPersonal(d) {
          return d.keys().hasOnly(['name', 'kind', 'checks', 'order', 'updatedAt'])
            && d.kind == 'personal'
            && shortString(d.name, 1, 80)
            && d.checks is map && d.checks.size() <= 100
            && d.order is number;
        }
        function changed() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        // 공용 항목: 담당 미정인 항목을 내가 가져가기 (모임장, 쓰기 멤버)
        function claiming() {
          return isMember(gid) && myRole(gid) in ['owner', 'writer']
            && resource.data.assigneeUid == null
            && request.resource.data.assigneeUid == request.auth.uid
            && changed().hasOnly(['assigneeUid', 'updatedAt']);
        }
        // 공용 항목: 내가 맡은 항목 놓기 (쓰기 멤버)
        function releasing() {
          return isMember(gid) && myRole(gid) == 'writer'
            && resource.data.assigneeUid == request.auth.uid
            && request.resource.data.assigneeUid == null
            && changed().hasOnly(['assigneeUid', 'updatedAt']);
        }
        // 개인 항목: 모임 멤버는 누구나(읽기 멤버 포함) 자기 칸만 체크
        function checkingMine() {
          return isMember(gid)
            && changed().hasOnly(['checks', 'updatedAt'])
            && request.resource.data.checks.diff(resource.data.checks).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.checks[request.auth.uid] is bool;
        }
        // 모임을 만드는 같은 배치에서 템플릿 항목을 함께 만들 때
        function creatingGroupNow() {
          return signedIn() && !exists(groupPath(gid))
            && getAfter(groupPath(gid)).data.ownerUid == request.auth.uid;
        }

        allow read: if isMember(gid);
        allow create: if (isOwner(gid) || creatingGroupNow())
          && (validShared(request.resource.data)
              || (validPersonal(request.resource.data) && request.resource.data.checks.size() == 0));
        allow delete: if isOwner(gid);
        allow update: if
          // 공용 항목
          (!isPersonal(resource.data) && validShared(request.resource.data) && (
            isOwner(gid)
            || claiming()
            || releasing()
            || (isMember(gid)
                && myRole(gid) == 'writer'
                && resource.data.assigneeUid == request.auth.uid
                && changed().hasOnly(['qty', 'done', 'memo', 'updatedAt']))
          ))
          // 개인 항목: 이름·순서는 모임장만, 체크는 본인 칸만
          || (isPersonal(resource.data) && validPersonal(request.resource.data) && (
            checkingMine()
            || (isOwner(gid) && request.resource.data.checks == resource.data.checks)
          ));
      }
    }

    // 초대 코드: 코드를 아는 사람만 하나씩 조회 가능 (목록 조회 불가)
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'createdBy', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && isOwner(request.resource.data.groupId);
      allow delete: if signedIn() && isOwner(resource.data.groupId);
    }
  }
}
